rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tes trades et tes captures : visibles et modifiables uniquement par toi.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Trades partagés : lisibles par quiconque a le lien (get), jamais listables,
    // modifiables uniquement par la personne qui les a créés.
    match /shared/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /shots/{shotId} {
        allow get: if true;
        allow list: if false;
        allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
        allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
                      && request.resource.data.ownerUid == request.auth.uid;
        allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      }
    }
  }
}
